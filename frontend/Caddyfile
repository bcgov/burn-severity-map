{
    auto_https off
}

http://:{{ .Values.global.ports.frontend }} {
    root * /usr/share/caddy

    route {
        # Reverse proxy API calls using dynamic service discovery names
        handle_path /pg-bs/* {
            reverse_proxy {{ include "backend.fullname" $ }}:{{ .Values.global.ports.backend }}
        }
        
        # Reverse proxy for additional API endpoints
        handle_path /api/* {
            reverse_proxy {{ include "backend.fullname" $ }}:{{ .Values.global.ports.backend }}
        }

        # Serve static frontend files
        handle {
            try_files {path} /index.html
            file_server
        }
    }
}

