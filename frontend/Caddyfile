:8080 {
    root * /usr/share/caddy

    route {
        # Reverse proxy API calls
        handle_path /pg-bs/* {
            reverse_proxy fastapi-backend:8000
        }
        
        # Reverse proxy for additional API endpoints
        handle_path /api/* {
            reverse_proxy fastapi-backend:8000
        }

        handle_path /run-analysis {
            reverse_proxy analysis-backend:5000
        }

        handle_path /analysis/* {
            reverse_proxy analysis-backend:5000
        }
        

        # Serve static frontend files
        handle {
            try_files {path} /index.html
            file_server
        }
    }
}

